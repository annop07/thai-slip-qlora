# Frontier-model baseline for the benchmark. Inference only — this endpoint has no
# fine-tuning API (GET /fine_tuning/jobs returns 404), which is why the training
# itself runs on a Colab T4 and not here.
OPENAI_API_KEY=sk_PASTE_YOUR_KEY_HERE
OPENAI_BASE_URL=https://gen.ai.kku.ac.th/api/v1

# Models used as the "call a big model over an API" row of the benchmark.
BASELINE_MODELS=qwen3-next-80b-a3b-instruct,gemini-3.6-flash
